<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>ai.storyteller.cadcraft</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Cadino</name>
  <summary>Draft, dimension and plot 2D drawings</summary>
  <developer>
    <name>Cadino contributors</name>
  </developer>
  <description>
    <p>
      Cadino is an open-source computer-aided design and drafting application with a familiar
      command line, object snaps, layers, dimensions, hatches and blocks. It opens and saves DXF
      and DWG drawings, exports SVG and PNG, and can be driven by AI agents over MCP. It is based
      on CADCraft by the ArtCraft team.
    </p>
  </description>
  <launchable type="desktop-id">ai.storyteller.cadcraft.desktop</launchable>
  <icon type="stock">ai.storyteller.cadcraft</icon>
  <!-- Cadino's homepage, bug tracker and contact go here once it has them (url types known to
       appstream 0.15: homepage, bugtracker, help, contact). Not CADCraft's or ArtCraft's. -->
  <categories>
    <category>Graphics</category>
    <category>Engineering</category>
  </categories>
  <keywords>
    <keyword>CAD</keyword>
    <keyword>drafting</keyword>
    <keyword>DXF</keyword>
    <keyword>DWG</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#9ee3f2</color>
    <color type="primary" scheme_preference="dark">#0b6f88</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>cadcraft</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
