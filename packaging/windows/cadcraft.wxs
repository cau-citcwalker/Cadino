<?xml version="1.0" encoding="utf-8"?>
<!--
  Cadino MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus the WixUI extension:
  `wix extension add -g WixToolset.UI.wixext/5.0.2`). Built by package.ps1:

    wix build cadcraft.wxs -arch x64 -ext WixToolset.UI.wixext -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  BinDir holds Cadino.exe, cadcraft-cli.exe, README-Cadino.txt, THIRD-PARTY-NOTICES.txt,
  LICENSE-MIT, LICENSE-APACHE and NOTICE.

  Per-machine install into Program Files\Cadino, a Start Menu shortcut, an optional desktop
  shortcut, and Cadino offered under "Open with" for .dxf and .dwg drawings (without taking over the
  user's default app).

  Its own identity (UpgradeCode, component GUIDs, ProgID, registry keys): it never upgrades,
  replaces or removes a CADCraft install.

  Desktop shortcut: the setup wizard asks (unchecked by default). Silent installs leave it out
  unless asked: `msiexec /i Cadino.msi /qn DESKTOPSHORTCUT=1`. Upgrades keep the previous choice
  unless DESKTOPSHORTCUT=1 or DESKTOPSHORTCUT=0 is given.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Cadino"
      Manufacturer="Cadino"
      Version="$(var.Version)"
      UpgradeCode="63081016-8F52-4054-9985-719FA0964FC3"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Cadino computer-aided design" Manufacturer="Cadino" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Cadino is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="CadinoIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="CadinoIcon.ico" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Cadino" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <!-- Per-machine (ALLUSERS=1), so this is the all-users (Public) desktop, like the Start Menu above. -->
    <StandardDirectory Id="DesktopFolder" />

    <!-- "Create a desktop shortcut": the wizard's checkbox sets it to 1 (cleared = unset), and
         silent installs pass DESKTOPSHORTCUT=1. Secure, so the elevated install sees the UI choice. -->
    <Property Id="DESKTOPSHORTCUT" Secure="yes" />
    <!-- The previous install's choice (the shortcut component's HKCU key path, so the installing
         user's), so upgrades keep the desktop shortcut without asking again. -->
    <Property Id="PREVIOUSDESKTOPSHORTCUT">
      <RegistrySearch Id="PreviousDesktopShortcut" Root="HKCU" Key="Software\Cadino"
          Name="DesktopShortcut" Type="raw" />
    </Property>
    <!-- Only when DESKTOPSHORTCUT wasn't given; "first" runs it once (in the UI sequence when there
         is one), so unticking the box isn't undone by the execute sequence. -->
    <SetProperty Id="DESKTOPSHORTCUT" Value="1" After="AppSearch" Sequence="first"
        Condition="NOT DESKTOPSHORTCUT AND PREVIOUSDESKTOPSHORTCUT = &quot;1&quot;" />

    <UIRef Id="CadinoUI" />

    <Feature Id="Main" Title="Cadino" Level="1">
      <ComponentGroupRef Id="CadinoFiles" />
    </Feature>
    <!-- Its own (hidden) feature: the advertised Start Menu shortcut health-checks its feature,
         Main, and the desktop shortcut's key path is in the installing user's HKCU. Were it in
         Main, any other user starting Cadino from the Start Menu would trigger a self-repair. -->
    <Feature Id="DesktopShortcutFeature" Title="Desktop shortcut" Level="1" Display="hidden">
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="CadinoFiles" Directory="INSTALLFOLDER">
      <Component Id="CadinoApp" Guid="65D5D06B-5BD7-44D4-8781-8A06338D33F6">
        <File Id="CadinoExe" Source="$(var.BinDir)\Cadino.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Cadino"
              Description="Cadino computer-aided design" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="CadinoIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\Cadino.exe" Value="[#CadinoExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\Cadino.exe\shell\open\command" Value="&quot;[#CadinoExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dxf\OpenWithProgids" Name="Cadino.Drawing" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dwg\OpenWithProgids" Name="Cadino.Drawing" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Cadino.Drawing" Value="Cadino drawing" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Cadino.Drawing\shell\open\command" Value="&quot;[#CadinoExe]&quot; &quot;%1&quot;" Type="string" />
      </Component>

      <Component Id="CadinoCli">
        <File Id="CadinoCliExe" Source="$(var.BinDir)\cadcraft-cli.exe" KeyPath="yes" />
      </Component>

      <!-- Read-me and the licences and notices the MIT/Apache terms of the upstream code and the
           dependencies require to travel with the binaries. -->
      <Component Id="ReadMe"><File Source="$(var.BinDir)\README-Cadino.txt" KeyPath="yes" /></Component>
      <Component Id="ThirdPartyNotices"><File Source="$(var.BinDir)\THIRD-PARTY-NOTICES.txt" KeyPath="yes" /></Component>
      <Component Id="LicenseMit"><File Source="$(var.BinDir)\LICENSE-MIT" KeyPath="yes" /></Component>
      <Component Id="LicenseApache"><File Source="$(var.BinDir)\LICENSE-APACHE" KeyPath="yes" /></Component>
      <Component Id="Notice"><File Source="$(var.BinDir)\NOTICE" KeyPath="yes" /></Component>
    </ComponentGroup>

    <!-- Optional desktop shortcut, removed on uninstall. A non-advertised shortcut needs a registry
         key path, and one in a profile folder (DesktopFolder, even though ALLUSERS=1 makes it the
         Public desktop) must be under HKCU (ICE38, ICE43, ICE57). -->
    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="3C7343E3-703E-408C-BA55-685300794DC4"
        Condition="DESKTOPSHORTCUT = &quot;1&quot;">
      <Shortcut Id="DesktopShortcut" Name="Cadino" Description="Cadino computer-aided design"
          Target="[INSTALLFOLDER]Cadino.exe" WorkingDirectory="INSTALLFOLDER" Icon="CadinoIcon.ico" IconIndex="0" />
      <RegistryValue Root="HKCU" Key="Software\Cadino" Name="DesktopShortcut"
          Value="1" Type="string" KeyPath="yes" />
    </Component>
  </Fragment>

  <!--
    Setup wizard: WixUI_InstallDir's flow (WiX v5, ext/UI/wixlib/WixUI_InstallDir.wxs) without the
    licence and folder pages, plus a Shortcuts page. The stock dialogs name the product through
    [ProductName] ("Cadino"):
      install:     Welcome > Shortcuts > Ready to install > Progress > Finish
      maintenance: Maintenance welcome > Repair/Remove > Ready > Progress > Finish
  -->
  <Fragment>
    <UI Id="CadinoUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Dialog Id="ShortcutsDlg" Width="370" Height="270" Title="!(loc.InstallDirDlg_Title)">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>

        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes"
            Text="Choose where to start [ProductName] from." />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes"
            Text="{\WixUI_Font_Title}Shortcuts" />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="StartMenuText" Type="Text" X="20" Y="60" Width="330" Height="15" NoPrefix="yes"
            Text="[ProductName] will be added to the Start menu." />
        <Control Id="DesktopShortcutCheckBox" Type="CheckBox" X="20" Y="85" Width="330" Height="17"
            Property="DESKTOPSHORTCUT" CheckBoxValue="1" Text="Create a &amp;desktop shortcut" />
      </Dialog>

      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="ShortcutsDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />

      <Publish Dialog="ShortcutsDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="ShortcutsDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ShortcutsDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="Installed AND PATCH" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />

      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />

      <!-- No "Change" in Apps & features: there is a single visible feature. -->
      <Property Id="ARPNOMODIFY" Value="1" />
    </UI>

    <UIRef Id="WixUI_Common" />
  </Fragment>
</Wix>
